{
  "component": "Icon",
  "spec": "10-tokens/06-iconography.md",
  "description": "Stroke-only, permanently. Icons are chrome and chrome recedes: a 1.5-stroke line sits over media like a caption, where a filled glyph would compete with it.",
  "clauses": {
    "MUST": [
      "Render on the 24x24 grid with round caps and joins, fill none, at one of the five sizes: 16, 20, 24, 28, 32.",
      "Resolve a chrome icon's default size from density: 16 at pointer, 20 at touch.",
      "Apply the optical stroke floor of 1.75 at 16px, and only at 16px. This is the system's one sanctioned stroke deviation and is never applied per-component.",
      "Accept a semantic ROLE, never a vendor glyph name. The role to glyph mapping is the system's private concern.",
      "Inherit the colour of the text it accompanies, via currentColor.",
      "Render active as stroke 2.0 plus colour.",
      "Carry a semantic label unless explicitly decorative, and mirror in RTL for exactly these roles: back, forward, chevronLeft, chevronRight, reply, forwardMessage, send.",
      "Provide a tooltip at pointer density when the action is icon-only."
    ],
    "SHOULD": [
      "Pair with a text label wherever space allows. Icons alone carry meaning only for the universally learned set: back, close, search, play.",
      "Crossfade glyph swaps (play to pause, mic to micOff) at duration.fast."
    ],
    "NEVER": [
      "Ship a solid or duotone tier. There is no filled active state, reactions included: a liked heart is an outlined heart at stroke 2.0 in colors.live.",
      "Mix stroke and filled icons on one surface.",
      "Render below 16px (use nothing) or above 32px (it is an illustration and leaves the system).",
      "Stretch the glyph to fill a hit target — padding provides the target.",
      "Hardcode a colour, or use an opacity-modulated brand colour.",
      "Animate glyph size directly; scaling shimmers the stroke. Animate the container instead.",
      "Stand alone for a destructive action without a text label.",
      "Invent a new metaphor for a role that already exists in the catalog."
    ]
  },
  "vendor": {
    "primary": "HugeIcons stroke-rounded (MIT)",
    "secondary": "Iconoir regular (MIT)",
    "shipped": "Iconoir regular — HugeIcons' free set has no SVG assets in its repository, so this realization ships the specification's sanctioned secondary vendor on identical 24-grid, 1.5-stroke, round-cap geometry.",
    "absentRoles": [
      "unfold",
      "cameraFlip",
      "captions",
      "live",
      "record",
      "waveform",
      "sticker",
      "gif",
      "filePdf",
      "receipt"
    ],
    "absentPolicy": "Absent roles are NOT substituted with look-alikes. live renders as the specified pulsing dot chip; the rest are unavailable until the primary vendor's assets can be supplied."
  },
